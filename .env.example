# ======================================================
# Vitamins HUB — Frontend Environment Variables Template
# نسخ هذا الملف إلى .env.local وملء القيم الفعلية
# ======================================================

# SECURITY RULE: لا تضع أي مفاتيح API خاصة هنا أبداً.
# المتغيرات التي تبدأ بـ NEXT_PUBLIC_ تكون مرئية للمتصفح.
# جميع استدعاءات AI والخدمات الخارجية تمر عبر Backend فقط.

# Backend API URL (داخلي — server-to-server)
BACKEND_URL=http://mithaly-backend:5000

# Frontend API URL (عام — يستخدمه المتصفح)
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# Site URL (مهم جداً للـ SEO والـ redirects)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

PORT=3000

# Google OAuth Client ID (هذا المتغير عام بطبيعته — مقبول في Frontend)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Tracking & Analytics Pixels (عامة — مقبولة في Frontend)
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_SNAPCHAT_PIXEL_ID=

# !! تحذير: لا تضع هنا مطلقاً !!
# APIFREE_API_KEY        — ينتمي للـ Backend فقط
# OPENROUTER_API_KEY     — ينتمي للـ Backend فقط
# GEMINI_API_KEY         — ينتمي للـ Backend فقط
# GROQ_API_KEY           — ينتمي للـ Backend فقط
# GOOGLE_INDEXING_*      — ينتمي للـ Backend فقط
# JWT_SECRET             — ينتمي للـ Backend فقط

